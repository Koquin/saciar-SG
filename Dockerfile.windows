# escape=`
FROM eclipse-temurin:17-jdk-windowsservercore-ltsc2022

SHELL ["powershell", "-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

ENV MAVEN_VERSION=3.9.9
ENV MAVEN_HOME=C:\tools\apache-maven-3.9.9
ENV PATH=C:\tools\apache-maven-3.9.9\bin;${PATH}

RUN New-Item -ItemType Directory -Path C:\tools | Out-Null; `
    Invoke-WebRequest -Uri ('https://archive.apache.org/dist/maven/maven-3/' + $env:MAVEN_VERSION + '/binaries/apache-maven-' + $env:MAVEN_VERSION + '-bin.zip') -OutFile C:\tools\maven.zip; `
    Expand-Archive -Path C:\tools\maven.zip -DestinationPath C:\tools; `
    Remove-Item C:\tools\maven.zip -Force

WORKDIR C:\app

COPY . C:\app

RUN @'
$ErrorActionPreference = "Stop"
Set-Location C:\app

mvn clean package

New-Item -ItemType Directory -Force -Path C:\out | Out-Null

jpackage `
  --type exe `
  --input target `
  --name "Sistema de gerenciamento Saciar" `
  --main-jar saciar-sistema-1.0.0.jar `
  --main-class com.saciar.SaciarApplication `
  --icon src\assets\icone.ico `
  --win-shortcut `
  --win-menu `
  --win-menu-group "Saciar" `
  --app-version 1.0.0 `
  --vendor "Saciar" `
  --dest C:\out `
  --installer-name "Instalador - Sistema de gerenciamento saciar"
'@ | Set-Content -Path C:\build-installer.ps1

CMD ["powershell", "-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "C:\\build-installer.ps1"]